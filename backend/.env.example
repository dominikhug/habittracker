# Copy to .env and fill in real values. Never commit .env itself.
#
# This file lives outside git's reach (.gitignore) — which also means nothing here
# survives a `git clean`, `git checkout -- .`, or similar. If that keeps happening on
# your machine, set these as persistent OS-level environment variables instead (e.g.
# Windows: [Environment]::SetEnvironmentVariable("AZURE_CLIENT_ID", "...", "User") in
# PowerShell, once per variable, then open a NEW terminal). `npm run dev` uses
# --env-file-if-exists, so it works fine with or without this file present — any
# variable already set in the environment is used as-is; this file only fills in
# whatever isn't already set.

# Railway/Produktion: NODE_ENV=production setzen (aktiviert secure Cookies via
# config.isProd UND das SPA-Static-Serving im Backend, siehe backend/src/app.ts).
# Lokal unset lassen.
NODE_ENV=

# Azure App Registration (see plan: "Azure App Registration")
# In Produktion muss die Railway-URL + /api/auth/callback als ZUSÄTZLICHE
# Redirect-URI in der Azure App Registration ergänzt werden, nicht als Ersatz
# für die localhost-URI unten — beide werden gebraucht.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=common
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 32-byte hex strings, generate each separately with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_KEY=
OAUTH_TXN_COOKIE_KEY=

# Local dev only: the SPA runs on Vite's own port (5173), separate from this backend
# (3000), so the post-login redirect needs to know where to send the browser back to.
# Leave unset in production (M7) — there the backend serves the built SPA itself, so a
# relative redirect is correct.
FRONTEND_URL=http://localhost:5173
